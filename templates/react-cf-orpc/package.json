{
  "name": "@samhwang/react-cf-orpc",
  "version": "1.0.0",
  "description": "Vite + React Starter Template",
  "type": "module",
  "scripts": {
    "prepare": "pnpm run githooks:init",
    "githooks:init": "husky",
    "msw:init": "msw init public --save",
    "dev": "vite",
    "build": "pnpm run wrangler:generate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:preview": "vitest-preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "drizzle:push": "dotenvx run -- drizzle-kit push",
    "drizzle:migrate:dev": "drizzle-kit generate && dotenvx run -- drizzle-kit migrate",
    "drizzle:migrate:prod": "dotenvx run -- drizzle-kit migrate",
    "drizzle:studio": "dotenvx run -- drizzle-kit studio",
    "auth:secret": "better-auth secret",
    "auth:generate": "dotenvx run -- better-auth generate --config ./src/auth/server.ts --output ./src/database/schema/auth.ts -y",
    "wrangler:generate": "mkdir -p src/api/generated && wrangler types src/api/generated/worker-configuration.d.ts --env-interface CloudflareEnv --env-file .env.sample"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@dotenvx/dotenvx": "^2.21.0",
    "@neondatabase/serverless": "^1.1.0",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-query-devtools": "^5.102.4",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.4",
    "lint-staged": "^17.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-vite-plugin": "^1.167.35",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "auth": "^1.7.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxc-transform-react": "^0.148.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-preview": "^0.0.3",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

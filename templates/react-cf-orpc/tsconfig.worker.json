{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ESNext"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "types": ["./src/api/generated/worker-configuration.d.ts", "vite/client", "hono", "node"]
  },
  "include": [
    "functions",
    "src/server.ts",
    "src/config",
    "src/database",
    "src/api/lib",
    "src/api/generated",
    "src/api/user",
    "src/api/router.ts",
    "src/auth/server.ts",
    "src/auth/server/middleware.ts",
    "src/auth/auth.server.test.ts"
  ]
}

{
  "name": "react-tanstack-start",
  "version": "1.0.0",
  "private": true,
  "description": "TanStack Start + React + Better Auth + Drizzle Starter Template",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "dotenvx run -- node .output/server/index.mjs",
    "test": "dotenvx run -- vitest run",
    "test:watch": "dotenvx run -- vitest watch",
    "test:coverage": "dotenvx run -- vitest run --coverage",
    "prepare": "pnpm run githooks:init",
    "githooks:init": "husky",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "drizzle:push": "dotenvx run -- drizzle-kit push",
    "drizzle:migrate:dev": "drizzle-kit generate && dotenvx run -- drizzle-kit migrate",
    "drizzle:migrate:prod": "dotenvx run -- drizzle-kit migrate",
    "drizzle:studio": "dotenvx run -- drizzle-kit studio",
    "auth:generate": "dotenvx run -- better-auth generate --config ./src/auth/server.ts --output ./src/database/schema/auth.ts -y",
    "auth:secret": "better-auth secret"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@dotenvx/dotenvx": "^2.28.2",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.56",
    "@tanstack/router-plugin": "^1.168.40",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "nitro": "3.0.260311-beta",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@oxc-node/cli": "^0.1.3",
    "@oxc-node/core": "^0.1.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "auth": "^1.7.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^17.5.1",
    "oxc-transform-react": "^0.150.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}

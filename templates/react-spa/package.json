{
  "name": "react-spa",
  "version": "1.0.0",
  "description": "Vite + React SPA Starter Template",
  "type": "module",
  "scripts": {
    "prepare": "pnpm run githooks:init",
    "githooks:init": "husky",
    "msw:init": "msw init public --save",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:preview": "vitest-preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.3",
    "@oxc-node/core": "^0.1.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-vite-plugin": "^1.167.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "oxc-transform-react": "^0.150.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-preview": "^0.0.3"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}

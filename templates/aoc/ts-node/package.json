{
  "name": "aoc",
  "version": "1.0.0",
  "description": "Advent of Code Template",
  "type": "module",
  "scripts": {
    "get-aoc-input": "oxnode --env-file-if-exists .env bin/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write ."
  },
  "dependencies": {
    "wretch": "^3.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.3",
    "@oxc-node/core": "^0.1.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}

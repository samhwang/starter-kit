{
  "name": "ts-lib",
  "version": "1.0.0",
  "description": "TypeScript Library Starter Template",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "homepage": "https://github.com/samhwang/PLACEHOLDER#readme",
  "bugs": "https://github.com/samhwang/PLACEHOLDER/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samhwang/PLACEHOLDER.git"
  },
  "scripts": {
    "prepare": "husky",
    "start": "tsx bin/index.ts",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:CI": "pnpm run test && pnpm run typecheck",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "ci": "oxlint . && oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}

{
  "name": "ts-lib",
  "version": "1.0.0",
  "description": "TypeScript Library Starter Template",
  "homepage": "https://github.com/samhwang/PLACEHOLDER#readme",
  "bugs": "https://github.com/samhwang/PLACEHOLDER/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samhwang/PLACEHOLDER.git"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "start": "oxnode bin/index.ts",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.0",
    "@oxc-node/core": "^0.1.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}

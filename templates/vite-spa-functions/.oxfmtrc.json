{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 160,
  "trailingComma": "es5",
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "arrowParens": "always",
  "sortImports": true,
  "ignorePatterns": ["dist", "server/generated", "src/routeTree.gen.ts", "public/mockServiceWorker.js"]
}

{
  "name": "tanstack-start",
  "version": "1.0.0",
  "private": true,
  "description": "TanStack Start + React + Better Auth + Prisma Starter Template",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "dotenvx run -- node .output/server/index.mjs",
    "test": "dotenvx run -- vitest",
    "test:run": "dotenvx run -- vitest run",
    "test:ui": "dotenvx run -- vitest --ui",
    "test:coverage": "dotenvx run -- vitest run --coverage",
    "prepare": "pnpm run githooks:init",
    "githooks:init": "husky",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "lint:ci": "oxlint . && oxfmt --check .",
    "typecheck": "tsc",
    "prisma:push": "dotenvx run -- prisma db push",
    "prisma:migrate:dev": "dotenvx run -- prisma migrate dev",
    "prisma:migrate:prod": "dotenvx run -- prisma migrate deploy",
    "prisma:format": "dotenvx run -- prisma format",
    "prisma:generate": "dotenvx run -- prisma generate",
    "prisma:studio": "dotenvx run -- prisma studio",
    "auth:generate": "dotenvx run -- better-auth generate --config ./src/auth/server.ts",
    "auth:secret": "better-auth secret"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.0",
    "@dotenvx/dotenvx": "^2.21.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.46",
    "@tanstack/router-plugin": "^1.168.32",
    "better-auth": "^1.7.0",
    "nitro": "3.0.260311-beta",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@tanstack/devtools-vite": "^0.8.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "4.0.18",
    "auth": "^1.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}

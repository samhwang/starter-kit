{
  "name": "tanstack-start",
  "version": "1.0.0",
  "private": true,
  "description": "TanStack Start + React + Better Auth + Prisma + Tailwind Starter Template",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "dotenvx run -- node .output/server/index.mjs",
    "test": "dotenvx run -- vitest",
    "test:run": "dotenvx run -- vitest run",
    "test:ui": "dotenvx run -- vitest --ui",
    "test:coverage": "dotenvx run -- vitest run --coverage",
    "prepare": "pnpm run githooks:init",
    "githooks:init": "husky",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "lint:ci": "oxlint . && oxfmt --check .",
    "typecheck": "tsc",
    "prisma:push": "dotenvx run -- prisma db push",
    "prisma:migrate:dev": "dotenvx run -- prisma migrate dev",
    "prisma:migrate:prod": "dotenvx run -- prisma migrate deploy",
    "prisma:format": "dotenvx run -- prisma format",
    "prisma:generate": "dotenvx run -- prisma generate",
    "prisma:studio": "dotenvx run -- prisma studio",
    "auth:generate": "dotenvx run -- better-auth generate --config ./src/auth/server.ts",
    "auth:secret": "better-auth secret"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.9",
    "@dotenvx/dotenvx": "^1.63.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-form-devtools": "^0.2.22",
    "@tanstack/react-form-start": "^1.29.1",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-devtools": "^5.100.5",
    "@tanstack/react-router": "^1.168.24",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-start": "^1.167.49",
    "@tanstack/router-plugin": "^1.167.27",
    "better-auth": "^1.6.9",
    "nitro": "3.0.260311-beta",
    "prisma": "^7.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vite-plugin": "^1.33.2",
    "@netlify/vite-plugin-tanstack-start": "^1.3.7",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "4.0.18",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.85.0"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}

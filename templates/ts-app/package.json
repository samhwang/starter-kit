{
  "name": "ts-app",
  "version": "1.0.0",
  "description": "TypeScript App Starter Template",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "oxnode bin/index.ts",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "ci": "pnpm run --parallel \"/^(lint|typecheck|test)$/\""
  },
  "devDependencies": {
    "@oxc-node/cli": "^0.1.3",
    "@oxc-node/core": "^0.1.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}

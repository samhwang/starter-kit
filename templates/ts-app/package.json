{
  "name": "ts-app",
  "version": "1.0.0",
  "description": "TypeScript App Starter Template",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "vite-node bin/index.ts",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:CI": "pnpm run test && pnpm run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.0.4",
    "husky": "^9.1.7",
    "lint-prepush": "^3.0.2",
    "lint-staged": "^16.2.6",
    "tsdown": "^0.15.11",
    "typescript": "^5.9.3",
    "vite-node": "^3.2.4",
    "vitest": "^4.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
